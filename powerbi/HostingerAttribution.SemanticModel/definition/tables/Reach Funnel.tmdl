	partition 'Reach Funnel' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\reach_funnel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"step_order", "step", "users", "conversion_from_start", "conversion_from_previous", "users_lost", "median_hours_from_previous"}),
					Typed = Table.TransformColumnTypes(Selected, {{"step_order", Int64.Type}, {"step", type text}, {"users", Int64.Type}, {"conversion_from_start", type number}, {"conversion_from_previous", type number}, {"users_lost", Int64.Type}, {"median_hours_from_previous", type number}}, "en-US")
				in
					Typed
