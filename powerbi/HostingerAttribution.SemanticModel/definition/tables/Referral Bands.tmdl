	partition 'Referral Bands' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\referral_by_band.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"reward_band_order", "reward_band", "referrals", "flagged_self_referrals", "avg_plan_months", "refund_rate", "programme_cost_eur", "cost_on_self_referrals_eur", "value_12m_clean_eur", "break_even_incrementality"}),
					Typed = Table.TransformColumnTypes(Selected, {{"reward_band_order", Int64.Type}, {"reward_band", type text}, {"referrals", Int64.Type}, {"flagged_self_referrals", Int64.Type}, {"avg_plan_months", type number}, {"refund_rate", type number}, {"programme_cost_eur", type number}, {"cost_on_self_referrals_eur", type number}, {"value_12m_clean_eur", type number}, {"break_even_incrementality", type number}}, "en-US")
				in
					Typed
