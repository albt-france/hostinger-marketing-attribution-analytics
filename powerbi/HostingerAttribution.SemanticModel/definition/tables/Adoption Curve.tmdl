table 'Adoption Curve'
	lineageTag: 5d2b349d-dfee-5617-8b39-e76d6a198a90

	column adoption_group
		dataType: string
		lineageTag: 3f659a38-0d40-5c96-8f54-7018589649fa
		summarizeBy: none
		sourceColumn: adoption_group

	column week
		dataType: int64
		formatString: 0
		lineageTag: 370e32be-b56c-5b8e-99d7-e42f491ea7e5
		summarizeBy: none
		sourceColumn: week

	column users_observed
		dataType: int64
		formatString: #,0
		lineageTag: 81167ac2-ae73-595e-807c-494df3e69066
		summarizeBy: none
		sourceColumn: users_observed

	column retention
		dataType: double
		formatString: 0%
		lineageTag: cb1fc8db-8d30-5042-996f-d99693a4d510
		summarizeBy: none
		sourceColumn: retention

	partition 'Adoption Curve' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\adoption_curve.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"adoption_group", "week", "users_observed", "retention"}),
					Typed = Table.TransformColumnTypes(Selected, {{"adoption_group", type text}, {"week", Int64.Type}, {"users_observed", Int64.Type}, {"retention", type number}}, "en-US")
				in
					Typed
