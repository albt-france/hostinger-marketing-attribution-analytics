	partition Affiliate = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\affiliate_scorecard.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"affiliate_id", "type", "main_country", "commission_rate", "last_click_orders", "commission_eur", "commission_per_order", "refund_rate_30d", "share_cart_already_started", "share_with_earlier_channel", "expected_value_12m_per_order"}),
					Typed = Table.TransformColumnTypes(Selected, {{"affiliate_id", type text}, {"type", type text}, {"main_country", type text}, {"commission_rate", type number}, {"last_click_orders", Int64.Type}, {"commission_eur", type number}, {"commission_per_order", type number}, {"refund_rate_30d", type number}, {"share_cart_already_started", type number}, {"share_with_earlier_channel", type number}, {"expected_value_12m_per_order", type number}}, "en-US")
				in
					Typed
