	partition 'Referral Scenarios' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\referral_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"reward_rate", "controls", "incrementality", "elasticity", "genuine_referrals_year", "self_referrals_year", "cost_year_eur", "incremental_value_year_eur", "net_value_year_eur"}),
					Typed = Table.TransformColumnTypes(Selected, {{"reward_rate", type number}, {"controls", type text}, {"incrementality", type number}, {"elasticity", type number}, {"genuine_referrals_year", type number}, {"self_referrals_year", type number}, {"cost_year_eur", type number}, {"incremental_value_year_eur", type number}, {"net_value_year_eur", type number}}, "en-US")
				in
					Typed
