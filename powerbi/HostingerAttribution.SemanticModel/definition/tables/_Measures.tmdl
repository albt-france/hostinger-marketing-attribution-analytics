table _Measures
	lineageTag: 6b63bc57-a79a-5617-9e47-8ff26ab3649b

	measure 'Total Spend' = SUM ( Spend[spend_eur] )
		formatString: €#,0
		displayFolder: Spend
		lineageTag: bc573d1b-834e-5082-89f5-7baab0fe912e

	measure 'Spend Share' = DIVIDE ( [Total Spend], CALCULATE ( [Total Spend], REMOVEFILTERS ( Channel ) ) )
		formatString: 0%
		displayFolder: Spend
		lineageTag: 90a07452-5716-532d-8f69-dc65adacd3b7

	measure 'Order Count' = COUNTROWS ( Orders )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 315fefae-3c54-5b2a-bc81-20c981409295

	measure 'Credited Orders' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( SUM ( 'Attribution Credits'[credit] ), 'Attribution Model'[model] = m )
		formatString: #,0
		displayFolder: Attribution
		lineageTag: 5b8ebe26-b313-5cb1-9ef5-f8e2b4ac158d

	measure 'Credit Share' = DIVIDE ( [Credited Orders], CALCULATE ( [Credited Orders], REMOVEFILTERS ( Channel ) ) )
		formatString: 0.0%
		displayFolder: Attribution
		lineageTag: eec12e61-560c-5541-b9b5-b393d18ab645

	measure 'Credit Share by Model' = DIVIDE ( SUM ( 'Attribution Credits'[credit] ), CALCULATE ( SUM ( 'Attribution Credits'[credit] ), REMOVEFILTERS ( Channel ) ) )
		formatString: 0.0%
		displayFolder: Attribution
		lineageTag: 7b91970e-4c43-58f6-a829-c1e123e1a61d

	measure 'Credited Value 30d' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( SUMX ( 'Attribution Credits', 'Attribution Credits'[credit] * RELATED ( Orders[net_value_30d] ) ), 'Attribution Model'[model] = m )
		formatString: €#,0
		displayFolder: Value
		lineageTag: 78d98c4c-868c-57e9-b094-f815224fd2a9

	measure 'Credited Value 12m' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( SUMX ( 'Attribution Credits', 'Attribution Credits'[credit] * RELATED ( Orders[expected_value_12m] ) ), 'Attribution Model'[model] = m )
		formatString: €#,0
		displayFolder: Value
		lineageTag: c2c4dc71-b72c-5e62-b698-18b78e170714

	measure CAC = DIVIDE ( [Total Spend], [Credited Orders] )
		formatString: €#,0
		displayFolder: Efficiency
		lineageTag: 12850b24-6971-588a-9e61-349e121e7d6b

	measure 'ROAS 30d' = DIVIDE ( [Credited Value 30d], [Total Spend] )
		formatString: 0%
		displayFolder: Efficiency
		lineageTag: e5d4cecc-6ed1-528c-b4da-eeef499407e2

	measure 'ROAS 12m' = DIVIDE ( [Credited Value 12m], [Total Spend] )
		formatString: 0%
		displayFolder: Efficiency
		lineageTag: c1e3c162-a3c2-5235-ab7a-5c89578770f2

	measure 'Value per Order 12m' = DIVIDE ( [Credited Value 12m], [Credited Orders] )
		formatString: €#,0
		displayFolder: Efficiency
		lineageTag: fb13f27a-65f5-5955-9cca-df04b015ab3a

	measure 'Net Return 12m' = [Credited Value 12m] - [Total Spend]
		formatString: €#,0
		displayFolder: Efficiency
		lineageTag: 5cb9ac49-fde6-54f3-a40c-e5507afbe4fd

	measure 'Refund Rate' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( DIVIDE ( SUMX ( FILTER ( 'Attribution Credits', RELATED ( Orders[mature_30d] ) && RELATED ( Orders[is_refunded] ) ), 'Attribution Credits'[credit] ), SUMX ( FILTER ( 'Attribution Credits', RELATED ( Orders[mature_30d] ) ), 'Attribution Credits'[credit] ) ), 'Attribution Model'[model] = m )
		formatString: 0.0%
		displayFolder: Quality
		lineageTag: f20f728c-ebcd-5553-9ee1-2b83cea6e044

	measure 'Long Plan Share' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( DIVIDE ( SUMX ( FILTER ( 'Attribution Credits', RELATED ( Orders[plan_months] ) >= 24 ), 'Attribution Credits'[credit] ), SUM ( 'Attribution Credits'[credit] ) ), 'Attribution Model'[model] = m )
		formatString: 0%
		displayFolder: Quality
		lineageTag: 7ee944c7-5398-5f67-9907-91ac96f6f1d5

	measure 'Renewal Rate' = VAR m = SELECTEDVALUE ( 'Attribution Model'[model], "Markov (data-driven)" ) RETURN CALCULATE ( DIVIDE ( SUMX ( FILTER ( 'Attribution Credits', RELATED ( Orders[renewed_first_time] ) ), 'Attribution Credits'[credit] ), SUMX ( FILTER ( 'Attribution Credits', RELATED ( Orders[has_renewal_decision] ) ), 'Attribution Credits'[credit] ) ), 'Attribution Model'[model] = m )
		formatString: 0%
		displayFolder: Quality
		lineageTag: 2afc4cfd-988b-5e53-b64d-acdc4842ffca

	measure 'LTV 24m' = SUM ( 'Channel Quality'[ltv_24m] )
		formatString: €#,0
		displayFolder: Customer value
		lineageTag: a678f23a-fbb7-5e46-9ce3-d42429549941

	measure 'CAC First Click' = SUM ( 'Channel Quality'[cac_first_click] )
		formatString: €#,0
		displayFolder: Customer value
		lineageTag: 91ca957c-05b2-5643-b929-be61830e5049

	measure 'Payback Month' = MIN ( 'Channel Quality'[payback_month] )
		formatString: 0
		displayFolder: Customer value
		lineageTag: e5208052-67c0-591b-9764-07cb7c629a00

	measure 'Refund Rate First Click' = AVERAGE ( 'Channel Quality'[refund_rate_30d] )
		formatString: 0.0%
		displayFolder: Customer value
		lineageTag: 3f144d02-4c83-5c8d-8d95-9a32ec5a28aa

	measure 'Renewal Rate First Click' = AVERAGE ( 'Channel Quality'[renewal_rate] )
		formatString: 0%
		displayFolder: Customer value
		lineageTag: 5f2b1a7d-d0f2-505c-bfff-ddc1138a00a7

	measure 'Cumulative Value per Order' = AVERAGE ( 'Value Curve'[cumulative_value_per_order] )
		formatString: €#,0
		displayFolder: Customer value
		lineageTag: e9ddc660-3c65-543c-885d-1c312e660921

	measure 'Creator Cost' = SUM ( Creator[cost_eur] )
		formatString: €#,0
		displayFolder: Creators & affiliates
		lineageTag: ee9e084e-eeb5-5b97-9e53-be0e2bfb7f90

	measure 'Genuine Creator Orders' = SUM ( Creator[genuine_orders] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: 8fdb448f-be39-52d1-8969-0e8b96a332b4

	measure 'Leaked Code Orders' = SUM ( Creator[leaked_code_orders] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: 30e5f081-bc2f-5b3d-9f82-ce2b081fad41

	measure 'Leaked Share of Code Orders' = DIVIDE ( [Leaked Code Orders], SUM ( Creator[code_orders] ) )
		formatString: 0%
		displayFolder: Creators & affiliates
		lineageTag: 440c3473-0ce5-5517-a9d4-4a605ce78ffe

	measure 'Weekly Code Orders' = SUM ( 'Code Usage'[code_orders] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: c32f941a-8c75-5f67-9f8f-8093b3ab7cff

	measure 'Weekly Leaked Code Orders' = SUM ( 'Code Usage'[leaked_code_orders] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: 7cd8d142-b43c-5150-94b4-d6ff1b57b7a5

	measure 'Weekly Genuine Code Orders' = [Weekly Code Orders] - [Weekly Leaked Code Orders]
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: 04818a0f-50e1-57ec-83f7-2056e7e4a604

	measure 'Videos Published' = SUM ( 'Code Usage'[videos] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: 9bb6ed2c-68f4-524e-b559-e321dd4c97a5

	measure 'Affiliate Commission' = SUM ( Affiliate[commission_eur] )
		formatString: €#,0
		displayFolder: Creators & affiliates
		lineageTag: 109a510f-b351-53e0-9d7a-5480dbd5285d

	measure 'Affiliate Orders' = SUM ( Affiliate[last_click_orders] )
		formatString: #,0
		displayFolder: Creators & affiliates
		lineageTag: b1adcdb7-3589-555a-bf8b-296eb1286e5d

	measure 'Affiliate Refund Rate' = DIVIDE ( SUMX ( Affiliate, Affiliate[refund_rate_30d] * Affiliate[last_click_orders] ), SUM ( Affiliate[last_click_orders] ) )
		formatString: 0.0%
		displayFolder: Creators & affiliates
		lineageTag: 4fb4ca10-edfb-5ebf-b673-315ec962582a

	measure 'Cart Already Started Share' = DIVIDE ( SUMX ( Affiliate, Affiliate[share_cart_already_started] * Affiliate[last_click_orders] ), SUM ( Affiliate[last_click_orders] ) )
		formatString: 0%
		displayFolder: Creators & affiliates
		lineageTag: 36bb890d-9d5a-537a-b910-aac9c6e3c3a4

	measure 'Brand Search Index' = AVERAGE ( 'Video Event Study'[index] )
		formatString: 0
		displayFolder: Incrementality
		lineageTag: 6d31be17-55ca-55f0-a103-7439e21a7e78

	measure 'Brand Ad Clicks' = SUM ( 'Geo Weekly'[brand_ad_clicks] )
		formatString: #,0
		displayFolder: Incrementality
		lineageTag: 1496d2d1-129a-5200-9f80-b2376219fdc6

	measure 'Organic Brand Clicks' = SUM ( 'Geo Weekly'[organic_brand_clicks] )
		formatString: #,0
		displayFolder: Incrementality
		lineageTag: 291b07b7-ad1f-57b0-b94f-61bbf0abb29b

	measure 'Brand Search Orders Index' = AVERAGE ( 'Geo Weekly'[orders_index] )
		formatString: 0
		displayFolder: Incrementality
		lineageTag: 419c9685-fef6-513c-bf77-87455823813d

	measure 'Cost per Incremental Order' = SUM ( 'Incremental Cost'[cost_per_incremental_order] )
		formatString: €#,0
		displayFolder: Incrementality
		lineageTag: 24f48299-ef28-596a-b064-41f6229b26ca

	measure 'Cost per Last-click Order' = SUM ( 'Incremental Cost'[cost_per_last_click_order] )
		formatString: €#,0
		displayFolder: Incrementality
		lineageTag: 69512718-bf20-515d-9c8b-fdddc9039b8e

	measure 'Reallocation Orders' = SUM ( Reallocation[incremental_orders_12m] )
		formatString: +#,0;-#,0;0
		displayFolder: Incrementality
		lineageTag: 396c033d-9fd2-5b0a-9475-6e12bfc19ede

	column '_'
		dataType: string
		isHidden
		lineageTag: 6e7eb4d7-492a-51cd-8d56-07bae6ce4f60
		summarizeBy: none
		sourceColumn: _

	partition _Measures = m
		mode: import
